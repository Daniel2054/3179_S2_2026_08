{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "width": "container",
    "height": "container",

    "projection": {
        "type": "mercator",
        "center": [145.0, -37.85],
        "scale": 40000
    },

    "layer": [
    {
        "data": {
            "url": "js/states.geojson",
            "format": {
                "type": "json",
                "property": "features"
            }
        },

        "transform": [
            {
                "filter": "datum.properties.STATE_NAME === 'Victoria'"
            }
        ],

        "mark": {
            "type": "geoshape",
            "stroke": "black",
            "fill": "lightgray",
            "strokeWidth": 1
        }
    },

    {
        "data": {
            "url": "js/victoria_roads_compact.geojson",
            "format": {
                "type": "json",
                "property": "features"
            }
        },

        "mark": {
            "type": "geoshape",
            "filled": false,
            "stroke": "white",
            "strokeWidth": 0.7
        }
    },

    {
        "data" : {
            "url": "data/LEGO_victorian_stores.csv"
        },
        "mark" : {
            "type": "circle",
            "tooltip" : {"content": "data"},
            "size": 100
        },

        "encoding" :{
            "longitude" : {
                "field" : "longitude",
                "type":"quantitative"
            },
            "latitude": {
                "field": "latitude", 
                "type": "quantitative"
            },
            "color" : {
                "field": "type_of_store",
                "type" : "nominal",
                "title" : "Store Type",
                "scale" : {
                    "domain": ["LEGOLAND Discovery", "Certified Store"],
                    "range" : ["red", "black"]
                },
                "legend": {
                    "orient": "top"
                }
            }
        }
    }

    ],
    "config": {
        "background": "#F3FAF9",
        "axis": {
            "titleColor": "#000000",
            "labelColor": "#000000",
            "labelFont": "sans-serif",
            "labelFontSize": 15,
            "titleFontSize": 15
        },
        "view": {
            "stroke": null
        }
    }
}