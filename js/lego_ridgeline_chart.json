{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "width": "container",
    "height": "container",

    "data": {
        "url": "data/LEGO_minifigures_by_year_theme_2010_2025.csv",
        "format": {
            "type": "csv",
            "parse": {
                "year": "number",
                "num_of_figs": "number"
            }
        }
    },

    "transform": [
        {
            "filter": "isValid(datum.num_of_figs) && datum.num_of_figs >= 0"
        },
        {
            "calculate": "datum.year <= 2013 ? '2010-2013' : datum.year <= 2017 ? '2014-2017' : datum.year <= 2021 ? '2018-2021' : '2022-2025'",
            "as": "year_group"
        },
        {
            "density": "num_of_figs",
            "groupby": ["year_group"],
            "bandwidth": 0.8,
            "extent": [0, 206],
            "steps": 210,
            "as": ["minifigure_count", "density"]
        }
    ],

    "mark": {
        "type": "area",
        "interpolate": "monotone",
        "opacity": 0.85,
        "clip": true
    },

    "encoding": {
        "x": {
            "field": "minifigure_count",
            "type": "quantitative",
            "title": "Minifigures per Theme",
            "scale": {
                "domain": [0, 206]
            },
            "axis": {
                "values": [0, 20, 40, 60, 80, 100, 120, 140, 160, 180, 200],
                "grid": false
            }
        },

        "y": {
            "field": "density",
            "type": "quantitative",
            "title": null,
            "axis": null,
            "scale": {
                "zero": true
            }
        },

        "row": {
            "field": "year_group",
            "type": "ordinal",
            "title": null,
            "sort": [
                "2010-2013",
                "2014-2017",
                "2018-2021",
                "2022-2025"
            ],
            "header": {
                "labelAngle": 0,
                "labelFontSize": 15
            }
        },

        "color": {
            "field": "year_group",
            "type": "ordinal",
            "scale": {
                "domain": [
                    "2010-2013",
                    "2014-2017",
                    "2018-2021",
                    "2022-2025"
                ],
                "range": [
                    "#FDBB84",
                    "#FC8D59",
                    "#EF6548",
                    "#D7301F"
                ]
            },
            "legend": null
        },

        "tooltip": [
            {
                "field": "year_group",
                "type": "ordinal",
                "title": "Release Period"
            },
            {
                "field": "minifigure_count",
                "type": "quantitative",
                "title": "Minifigures per Theme",
                "format": ".0f"
            }
        ]
    },

    "config": {
        "background": "#F3FAF9",
        "facet": {
            "spacing": 0
        },
        "view": {
            "stroke": null
        },
        "axis": {
            "titleColor": "#000000",
            "labelColor": "#000000",
            "labelFont": "sans-serif",
            "labelFontSize": 15,
            "titleFontSize": 15
        }
    }
}